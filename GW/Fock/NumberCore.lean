module
public import GW.Fock.Number
public import GW.Operators.CoreInterface
public import GW.Spaces.WeightedCarrier
@[expose] public section
noncomputable section
open scoped Topology InnerProductSpace
open Filter
namespace GW.Fock
section DiagonalCore
variable (E : ℕ → Type*) [∀ n, NormedAddCommGroup (E n)] [∀ n, InnerProductSpace ℂ (E n)]

lemma scalarDiagonal_graph_iff (a : ℕ → ℝ) (p : lp E 2 × lp E 2) :
    p ∈ (scalarDiagonal E a).graph ↔ ∀ n, p.2 n = (a n : ℂ) • p.1 n := by
  constructor
  · intro h
    obtain ⟨u,hu,hv⟩ := (scalarDiagonal E a).mem_graph_iff.mp h
    intro n
    rw [← hv,scalarDiagonal_apply,hu]
  · intro h
    have hm : p.1 ∈ (scalarDiagonal E a).domain := by
      change Memℓp (fun n => (a n : ℂ) • p.1 n) 2
      convert lp.memℓp p.2 using 1
      exact funext (fun n => (h n).symm)
    exact (scalarDiagonal E a).mem_graph_iff.mpr
      ⟨⟨p.1,hm⟩,rfl,by apply lp.ext;funext n;exact (h n).symm⟩

lemma scalarDiagonal_closed (a : ℕ → ℝ) : (scalarDiagonal E a).IsClosed := by
  change IsClosed ((scalarDiagonal E a).graph : Set (lp E 2 × lp E 2))
  have he : ((scalarDiagonal E a).graph : Set (lp E 2 × lp E 2)) =
      ⋂ n, {p | p.2 n = (a n : ℂ) • p.1 n} := by
    ext p
    simp only [Set.mem_iInter,Set.mem_ofPred_eq]
    exact scalarDiagonal_graph_iff E a p
  rw [he]
  apply isClosed_iInter
  intro n
  exact isClosed_eq ((lp.evalCLM ℂ E 2 n).continuous.comp continuous_snd)
    (((lp.evalCLM ℂ E 2 n).continuous.comp continuous_fst).const_smul (a n : ℂ))

lemma scalarDiagonal_single_mem (a : ℕ → ℝ) (n : ℕ) (x : E n) :
    lp.single 2 n x ∈ (scalarDiagonal E a).domain := by
  change Memℓp (fun j => (a j : ℂ) • lp.single 2 n x j) 2
  convert lp.memℓp (lp.single 2 n ((a n : ℂ) • x)) using 1
  funext j
  by_cases hj : j = n
  · subst j; simp only [lp.single_apply_self]
  · simp only [lp.single_apply_ne _ _ _ hj,smul_zero]

lemma scalarDiagonal_single_apply (a : ℕ → ℝ) (n : ℕ) (x : E n) :
    scalarDiagonal E a ⟨lp.single 2 n x,scalarDiagonal_single_mem E a n x⟩ =
      lp.single 2 n ((a n : ℂ) • x) := by
  apply lp.ext
  funext j
  rw [scalarDiagonal_apply]
  by_cases hj : j = n
  · subst j; simp only [lp.single_apply_self]
  · simp only [lp.single_apply_ne _ _ _ hj,smul_zero]

lemma scalarDiagonal_cutoff_mem (a : ℕ → ℝ) (m : ℕ) (u : lp E 2) :
    cutoff E m u ∈ (scalarDiagonal E a).domain := by
  rw [cutoff_sum]
  exact Submodule.sum_mem _ (fun j hj => scalarDiagonal_single_mem E a j (u j))

lemma scalarDiagonal_dense (a : ℕ → ℝ) : Dense ((scalarDiagonal E a).domain : Set (lp E 2)) := by
  apply (dense_finite_sectors E).mono
  intro u hu
  obtain ⟨m,v,rfl⟩ := Set.mem_iUnion.mp hu
  exact scalarDiagonal_cutoff_mem E a m v

lemma scalarDiagonal_symmetric (a : ℕ → ℝ) :
    (scalarDiagonal E a).IsFormalAdjoint (scalarDiagonal E a) := by
  intro u v
  rw [lp.inner_eq_tsum,lp.inner_eq_tsum]
  apply tsum_congr
  intro n
  rw [scalarDiagonal_apply,scalarDiagonal_apply,inner_smul_left,inner_smul_right]
  simp only [Complex.conj_ofReal]

/-- The actual subspace generated by all finite-sector projections. -/
def finiteSectorDomain : Submodule ℂ (lp E 2) :=
  ⨆ m, (cutoff E m).toLinearMap.range

lemma cutoff_mem_finiteSectorDomain (m : ℕ) (u : lp E 2) :
    cutoff E m u ∈ finiteSectorDomain E :=
  (le_iSup (fun m => (cutoff E m).toLinearMap.range) m) ⟨u,rfl⟩

lemma finiteSectorDomain_le (a : ℕ → ℝ) :
    finiteSectorDomain E ≤ (scalarDiagonal E a).domain := by
  apply iSup_le
  intro m u hu
  obtain ⟨v,rfl⟩ := hu
  exact scalarDiagonal_cutoff_mem E a m v

set_option backward.isDefEq.respectTransparency.types false in
lemma finiteSectorDomain_iff (u : lp E 2) :
    u ∈ finiteSectorDomain E ↔ ∃ m : ℕ, ∀ n : ℕ, m < n → u n = 0 := by
  constructor
  · intro hu
    refine Submodule.iSup_induction (fun m => (cutoff E m).toLinearMap.range)
      (motive := fun v : lp E 2 => ∃ m : ℕ, ∀ n : ℕ, m < n → v n = 0) hu ?_ ?_ ?_
    · intro m v hv
      obtain ⟨w,rfl⟩ := hv
      refine ⟨m,fun n hn => ?_⟩
      change cutoff E m w n = 0
      exact (cutoff_apply E m w n).trans (ite_eq_right (not_le_of_gt hn))
    · exact ⟨0,fun n _ => by simp only [lp.coeFn_zero,Pi.zero_apply]⟩
    · intro v w hv hw
      obtain ⟨m,hm⟩ := hv
      obtain ⟨k,hk⟩ := hw
      refine ⟨max m k,fun n hn => ?_⟩
      simp only [lp.coeFn_add,Pi.add_apply,hm n (lt_of_le_of_lt (le_max_left _ _) hn),
        hk n (lt_of_le_of_lt (le_max_right _ _) hn),add_zero]
  · rintro ⟨m,hm⟩
    have he : cutoff E m u = u := by
      apply lp.ext
      funext n
      rw [cutoff_apply]
      split_ifs with hn
      · rfl
      · exact (hm n (lt_of_not_ge hn)).symm
    rw [← he]
    exact cutoff_mem_finiteSectorDomain E m u

lemma scalarDiagonal_cutoff_apply (a : ℕ → ℝ) (m : ℕ) (u : (scalarDiagonal E a).domain) :
    scalarDiagonal E a ⟨cutoff E m u,scalarDiagonal_cutoff_mem E a m u⟩ =
      cutoff E m (scalarDiagonal E a u) := by
  apply lp.ext
  funext n
  rw [scalarDiagonal_apply,cutoff_apply,cutoff_apply,scalarDiagonal_apply]
  split_ifs <;> simp only [smul_zero]

lemma scalarDiagonal_cutoff_graph_tendsto (a : ℕ → ℝ) (u : (scalarDiagonal E a).domain) :
    Tendsto (fun m => (cutoff E m u,
      scalarDiagonal E a ⟨cutoff E m u,scalarDiagonal_cutoff_mem E a m u⟩)) atTop
      (𝓝 ((u : lp E 2),scalarDiagonal E a u)) := by
  simp only [scalarDiagonal_cutoff_apply]
  exact (cutoff_tendsto E (u : lp E 2)).prodMk_nhds (cutoff_tendsto E (scalarDiagonal E a u))

lemma scalarDiagonal_finite_core (a : ℕ → ℝ) :
    (scalarDiagonal E a).HasCore (finiteSectorDomain E) := by
  have hle : (scalarDiagonal E a).domRestrict (finiteSectorDomain E) ≤ scalarDiagonal E a :=
    LinearPMap.domRestrict_le
  have hc := (scalarDiagonal_closed E a).isClosable.leIsClosable hle
  refine ⟨finiteSectorDomain_le E a,LinearPMap.eq_of_eq_graph ?_⟩
  rw [← hc.graph_closure_eq_closure_graph]
  apply SetLike.coe_injective
  change closure (((scalarDiagonal E a).domRestrict (finiteSectorDomain E)).graph : Set (lp E 2 × lp E 2)) = ((scalarDiagonal E a).graph : Set (lp E 2 × lp E 2))
  apply le_antisymm
  · exact closure_minimal (LinearPMap.le_graph_of_le hle) (scalarDiagonal_closed E a)
  · intro p hp
    obtain ⟨u,hu⟩ := (scalarDiagonal E a).mem_graph_iff'.mp hp
    rw [← hu]
    apply mem_closure_of_tendsto (scalarDiagonal_cutoff_graph_tendsto E a u)
    apply Eventually.of_forall
    intro m
    exact (scalarDiagonal E a).domRestrict (finiteSectorDomain E) |>.mem_graph_iff.mpr
      ⟨⟨cutoff E m u,⟨cutoff_mem_finiteSectorDomain E m u,scalarDiagonal_cutoff_mem E a m u⟩⟩,
        rfl,rfl⟩

lemma reciprocalFiber_bound (a : ℕ → ℝ) (ha : ∀ n, 1 ≤ a n) (n : ℕ) :
    ‖(↑((a n)⁻¹) : ℂ) • (ContinuousLinearMap.id ℂ (E n))‖ ≤ 1 := by
  apply ContinuousLinearMap.opNorm_le_bound _ zero_le_one
  intro x
  change ‖(↑((a n)⁻¹) : ℂ) • x‖ ≤ 1*‖x‖
  rw [norm_smul,Complex.norm_real,Real.norm_eq_abs,
    abs_of_nonneg (inv_nonneg.mpr (le_trans zero_le_one (ha n)))]
  exact mul_le_mul_of_nonneg_right (inv_le_one_of_one_le₀ (ha n)) (norm_nonneg _)

def scalarReciprocal (a : ℕ → ℝ) (ha : ∀ n, 1 ≤ a n) : lp E 2 →L[ℂ] lp E 2 :=
  GW.Spaces.diagonalMap (fun n => (↑((a n)⁻¹) : ℂ) • ContinuousLinearMap.id ℂ (E n))
    zero_le_one (reciprocalFiber_bound E a ha)

lemma scalarReciprocal_apply (a : ℕ → ℝ) (ha : ∀ n, 1 ≤ a n) (u : lp E 2) (n : ℕ) :
    scalarReciprocal E a ha u n = (↑((a n)⁻¹) : ℂ) • u n := rfl

lemma scalarReciprocal_norm (a : ℕ → ℝ) (ha : ∀ n, 1 ≤ a n) :
    ‖scalarReciprocal E a ha‖ ≤ 1 :=
  GW.Spaces.diagonalMap_opNorm _ zero_le_one (reciprocalFiber_bound E a ha)

set_option backward.isDefEq.respectTransparency.types false in
lemma scalarReciprocal_product (a : ℕ → ℝ) (ha : ∀ n, 1 ≤ a n) (u : lp E 2) :
    (fun n => (a n : ℂ) • scalarReciprocal E a ha u n) = fun n => u n := by
  funext n
  rw [scalarReciprocal_apply,smul_smul]
  have hn : a n ≠ 0 := ne_of_gt (lt_of_lt_of_le zero_lt_one (ha n))
  simp only [← Complex.ofReal_mul,mul_inv_cancel₀ hn,Complex.ofReal_one,one_smul]

lemma scalarReciprocal_mem (a : ℕ → ℝ) (ha : ∀ n, 1 ≤ a n) (u : lp E 2) :
    scalarReciprocal E a ha u ∈ (scalarDiagonal E a).domain := by
  change Memℓp (fun n => (a n : ℂ) • scalarReciprocal E a ha u n) 2
  rw [scalarReciprocal_product]
  exact lp.memℓp u

lemma scalarDiagonal_reciprocal (a : ℕ → ℝ) (ha : ∀ n, 1 ≤ a n) (u : lp E 2) :
    scalarDiagonal E a ⟨scalarReciprocal E a ha u,scalarReciprocal_mem E a ha u⟩ = u := by
  apply lp.ext
  exact scalarReciprocal_product E a ha u

set_option backward.isDefEq.respectTransparency.types false in
lemma scalarReciprocal_diagonal (a : ℕ → ℝ) (ha : ∀ n, 1 ≤ a n)
    (u : (scalarDiagonal E a).domain) :
    scalarReciprocal E a ha (scalarDiagonal E a u) = (u : lp E 2) := by
  apply lp.ext
  funext n
  rw [scalarReciprocal_apply,scalarDiagonal_apply,smul_smul]
  have hn : a n ≠ 0 := ne_of_gt (lt_of_lt_of_le zero_lt_one (ha n))
  simp only [← Complex.ofReal_mul,inv_mul_cancel₀ hn,Complex.ofReal_one,one_smul]

lemma scalarReciprocal_injective (a : ℕ → ℝ) (ha : ∀ n, 1 ≤ a n) :
    Function.Injective (scalarReciprocal E a ha) := by
  intro u v h
  apply lp.ext
  have hh := congrArg (fun z : lp E 2 => fun n => (a n : ℂ) • z n) h
  simpa only [scalarReciprocal_product] using hh

lemma scalarReciprocal_range (a : ℕ → ℝ) (ha : ∀ n, 1 ≤ a n) :
    Set.range (scalarReciprocal E a ha) = ((scalarDiagonal E a).domain : Set (lp E 2)) := by
  ext u
  constructor
  · rintro ⟨v,rfl⟩
    exact scalarReciprocal_mem E a ha v
  · intro hu
    exact ⟨scalarDiagonal E a ⟨u,hu⟩,scalarReciprocal_diagonal E a ha ⟨u,hu⟩⟩

/-- Named copy of the original complete ambient sum, with its original norm. -/
def DiagonalGraphCarrier (_a : ℕ → ℝ) : Type _ := lp E 2
instance diagonalGraphNorm (a : ℕ → ℝ) : NormedAddCommGroup (DiagonalGraphCarrier E a) :=
  inferInstanceAs (NormedAddCommGroup (lp E 2))
instance diagonalGraphInner (a : ℕ → ℝ) : InnerProductSpace ℂ (DiagonalGraphCarrier E a) :=
  inferInstanceAs (InnerProductSpace ℂ (lp E 2))
instance diagonalGraphComplete (a : ℕ → ℝ) [∀ n, CompleteSpace (E n)] :
    CompleteSpace (DiagonalGraphCarrier E a) := inferInstanceAs (CompleteSpace (lp E 2))

def diagonalWeightedGraph (a : ℕ → ℝ) (ha : ∀ n, 1 ≤ a n) :
    GW.Spaces.WeightedGraph (lp E 2) (DiagonalGraphCarrier E a) where
  domain := (scalarDiagonal E a).domain
  embedding := scalarReciprocal E a ha
  embedding_injective := scalarReciprocal_injective E a ha
  embedding_norm_le := scalarReciprocal_norm E a ha
  embedding_dense := by
    change Dense (Set.range (scalarReciprocal E a ha))
    rw [scalarReciprocal_range]
    exact scalarDiagonal_dense E a
  product := (scalarDiagonal E a).toFun
  embedding_mem := scalarReciprocal_mem E a ha
  product_embedding := scalarDiagonal_reciprocal E a ha
  embedding_product := scalarReciprocal_diagonal E a ha

lemma shiftedNumber_weight_one (r : ℝ) (hr : 0 ≤ r) (n : ℕ) :
    1 ≤ ((n : ℝ)+1)^r := Real.one_le_rpow (by have h := Nat.cast_nonneg (α := ℝ) n; linarith) hr

abbrev NumberGraphCarrier (r : ℝ) := DiagonalGraphCarrier E (fun n => ((n : ℝ)+1)^r)
def numberWeightedGraph (r : ℝ) (hr : 0 ≤ r) :
    GW.Spaces.WeightedGraph (lp E 2) (NumberGraphCarrier E r) :=
  diagonalWeightedGraph E (fun n => ((n : ℝ)+1)^r) (shiftedNumber_weight_one r hr)

section SelfAdjoint
variable [∀ n, CompleteSpace (E n)]

lemma scalarDiagonal_adjoint_coordinates (a : ℕ → ℝ)
    (v : (scalarDiagonal E a).adjoint.domain) (n : ℕ) :
    (scalarDiagonal E a).adjoint v n = (a n : ℂ) • (v : lp E 2) n := by
  apply ext_inner_left ℂ
  intro x
  have h := GW.Operators.adjoint_pairing (scalarDiagonal E a) (scalarDiagonal_dense E a)
    ⟨lp.single 2 n x,scalarDiagonal_single_mem E a n x⟩ v
  rw [scalarDiagonal_single_apply,lp.inner_single_left,lp.inner_single_left,
    inner_smul_left,Complex.conj_ofReal] at h
  rw [inner_smul_right]
  exact h.symm

lemma scalarDiagonal_selfadjoint (a : ℕ → ℝ) : IsSelfAdjointOperator (scalarDiagonal E a) := by
  have hd := scalarDiagonal_dense E a
  refine ⟨hd,le_antisymm ?_ (LinearPMap.IsFormalAdjoint.le_adjoint hd (scalarDiagonal_symmetric E a))⟩
  refine ⟨?_,?_⟩
  · intro v hv
    change Memℓp (fun n => (a n : ℂ) • v n) 2
    convert lp.memℓp ((scalarDiagonal E a).adjoint ⟨v,hv⟩) using 1
    exact funext (fun n => (scalarDiagonal_adjoint_coordinates E a ⟨v,hv⟩ n).symm)
  · intro v w hvw
    apply lp.ext
    funext n
    rw [scalarDiagonal_apply,scalarDiagonal_adjoint_coordinates,hvw]

lemma shiftedNumberPower_selfadjoint (r : ℝ) : IsSelfAdjointOperator (shiftedNumberPower E r) :=
  scalarDiagonal_selfadjoint E (fun n => ((n : ℝ)+1)^r)
lemma numberPower_selfadjoint (r : ℝ) : IsSelfAdjointOperator (numberPower E r) :=
  scalarDiagonal_selfadjoint E (numberPowerCoefficient r)
lemma numberDiagonal_selfadjoint : IsSelfAdjointOperator (numberDiagonal E) :=
  scalarDiagonal_selfadjoint E (fun n => (n : ℝ))
end SelfAdjoint

lemma shiftedNumberPower_core (r : ℝ) :
    (shiftedNumberPower E r).HasCore (finiteSectorDomain E) :=
  scalarDiagonal_finite_core E (fun n => ((n : ℝ)+1)^r)
lemma numberPower_core (r : ℝ) : (numberPower E r).HasCore (finiteSectorDomain E) :=
  scalarDiagonal_finite_core E (numberPowerCoefficient r)

lemma numberGraphEmbedding_apply (r : ℝ) (hr : 0 ≤ r) (v : NumberGraphCarrier E r) (n : ℕ) :
    (numberWeightedGraph E r hr).embedding v n =
      (↑(((n : ℝ)+1)^(-r)) : ℂ) • (show lp E 2 from v) n := by
  change (↑((((n : ℝ)+1)^r)⁻¹) : ℂ) • (show lp E 2 from v) n = _
  rw [Real.rpow_neg (by positivity : 0 ≤ (n : ℝ)+1)]

/-- The mathematical domain uses the product norm, via the separate named carrier. -/
abbrev NumberWeightedDomain (r : ℝ) (hr : 0 ≤ r) :=
  GW.Spaces.WeightedDomain (numberWeightedGraph E r hr)

def numberDomainIsometry (r : ℝ) (hr : 0 ≤ r) :
    NumberWeightedDomain E r hr ≃ₗᵢ[ℂ] NumberGraphCarrier E r :=
  GW.Spaces.weightedDomainIsometry (numberWeightedGraph E r hr)

set_option backward.isDefEq.respectTransparency.types false in
lemma numberWeighted_norm_sq (r : ℝ) (hr : 0 ≤ r) (u : NumberWeightedDomain E r hr) :
    ‖u‖^2 = ∑' n : ℕ, ((n : ℝ)+1)^(2*r) *
      ‖(show lp E 2 from (show (numberWeightedGraph E r hr).domain from u)) n‖^2 := by
  rw [GW.Spaces.weightedDomain_norm]
  change ‖scalarDiagonal E (fun n => ((n : ℝ)+1)^r) u‖^2 = _
  rw [scalarDiagonal_norm_sq]
  apply tsum_congr
  intro n
  rw [rpow_square _ _ (by positivity : 0 ≤ (n : ℝ)+1)]

set_option backward.isDefEq.respectTransparency.types false in
lemma numberWeighted_inner (r : ℝ) (hr : 0 ≤ r) (u v : NumberWeightedDomain E r hr) :
    ⟪u,v⟫_ℂ = ∑' n : ℕ, (↑(((n : ℝ)+1)^(2*r)) : ℂ) *
      ⟪(show lp E 2 from (show (numberWeightedGraph E r hr).domain from u)) n,
        (show lp E 2 from (show (numberWeightedGraph E r hr).domain from v)) n⟫_ℂ := by
  rw [GW.Spaces.weightedDomain_inner]
  change ⟪scalarDiagonal E (fun n => ((n : ℝ)+1)^r) u,
    scalarDiagonal E (fun n => ((n : ℝ)+1)^r) v⟫_ℂ = _
  rw [lp.inner_eq_tsum]
  apply tsum_congr
  intro n
  rw [scalarDiagonal_apply,scalarDiagonal_apply,inner_smul_left,inner_smul_right,
    Complex.conj_ofReal,← mul_assoc,← Complex.ofReal_mul,← sq,
    rpow_square _ _ (by positivity : 0 ≤ (n : ℝ)+1)]

set_option backward.isDefEq.respectTransparency.types false in
lemma numberWeighted_inner_summable (r : ℝ) (hr : 0 ≤ r) (u v : NumberWeightedDomain E r hr) :
    Summable (fun n : ℕ => (↑(((n : ℝ)+1)^(2*r)) : ℂ) *
      ⟪(show lp E 2 from (show (numberWeightedGraph E r hr).domain from u)) n,
        (show lp E 2 from (show (numberWeightedGraph E r hr).domain from v)) n⟫_ℂ) := by
  have h := lp.summable_inner (𝕜 := ℂ)
    (scalarDiagonal E (fun n => ((n : ℝ)+1)^r) (show (numberWeightedGraph E r hr).domain from u))
    (scalarDiagonal E (fun n => ((n : ℝ)+1)^r) (show (numberWeightedGraph E r hr).domain from v))
  apply h.congr
  intro n
  rw [scalarDiagonal_apply,scalarDiagonal_apply,inner_smul_left,inner_smul_right,
    Complex.conj_ofReal,← mul_assoc,← Complex.ofReal_mul,← sq,
    rpow_square _ _ (by positivity : 0 ≤ (n : ℝ)+1)]

set_option backward.isDefEq.respectTransparency.types false in
def numberWeightedCutoff (r : ℝ) (hr : 0 ≤ r) (m : ℕ) (u : NumberWeightedDomain E r hr) :
    NumberWeightedDomain E r hr :=
  show (numberWeightedGraph E r hr).domain from
    ⟨cutoff E m (show lp E 2 from (show (numberWeightedGraph E r hr).domain from u)),
      scalarDiagonal_cutoff_mem E (fun n => ((n : ℝ)+1)^r) m _⟩

set_option backward.isDefEq.respectTransparency.types false in
lemma numberWeightedCutoff_tendsto (r : ℝ) (hr : 0 ≤ r) (u : NumberWeightedDomain E r hr) :
    Tendsto (fun m => numberWeightedCutoff E r hr m u) atTop (𝓝 u) := by
  rw [(numberDomainIsometry E r hr).isometry.tendsto_nhds_iff]
  change Tendsto (fun m => scalarDiagonal E (fun n => ((n : ℝ)+1)^r)
    ⟨cutoff E m (show lp E 2 from (show (numberWeightedGraph E r hr).domain from u)),
      scalarDiagonal_cutoff_mem E (fun n => ((n : ℝ)+1)^r) m _⟩) atTop
    (𝓝 (scalarDiagonal E (fun n => ((n : ℝ)+1)^r) (show (numberWeightedGraph E r hr).domain from u)))
  simpa only [scalarDiagonal_cutoff_apply] using
    cutoff_tendsto E (scalarDiagonal E (fun n => ((n : ℝ)+1)^r)
      (show (numberWeightedGraph E r hr).domain from u))

def numberGraphCopy (r : ℝ) : lp E 2 ≃ₗᵢ[ℂ] NumberGraphCarrier E r :=
  LinearIsometryEquiv.refl ℂ (lp E 2)

/-- The reciprocal map is an onto isometry into the actual product-norm domain. -/
def numberReciprocalIsometry (r : ℝ) (hr : 0 ≤ r) :
    lp E 2 ≃ₗᵢ[ℂ] NumberWeightedDomain E r hr :=
  (numberGraphCopy E r).trans (numberDomainIsometry E r hr).symm

set_option backward.isDefEq.respectTransparency.types false in
lemma numberReciprocalIsometry_ambient (r : ℝ) (hr : 0 ≤ r) (u : lp E 2) :
    (numberWeightedGraph E r hr).domain.subtype
      (show (numberWeightedGraph E r hr).domain from numberReciprocalIsometry E r hr u) =
        (numberWeightedGraph E r hr).embedding (numberGraphCopy E r u) := by
  have he : (numberWeightedGraph E r hr).product
      (show (numberWeightedGraph E r hr).domain from numberReciprocalIsometry E r hr u) =
      numberGraphCopy E r u :=
    (numberDomainIsometry E r hr).apply_symm_apply (numberGraphCopy E r u)
  exact ((numberWeightedGraph E r hr).embedding_product _).symm.trans
    (congrArg (numberWeightedGraph E r hr).embedding he)

lemma numberWeighted_lift_iff (r s : ℝ) (hr : 0 ≤ r) (hs : 0 ≤ s)
    (T : lp E 2 →ₗ[ℂ] lp E 2) (c : ℝ) (hc : 0 ≤ c) :
    GW.Spaces.weightedBoundOnDomain (numberWeightedGraph E r hr) (numberWeightedGraph E s hs) T c ↔
      ∃! L : NumberGraphCarrier E r →L[ℂ] NumberGraphCarrier E s,
        ‖L‖ ≤ c ∧ GW.Spaces.CarrierIntertwines (numberWeightedGraph E r hr).embedding
          (numberWeightedGraph E s hs).embedding T L :=
  GW.Spaces.weightedGraph_lift_iff _ _ T hc

end DiagonalCore
abbrev phononNumberWeightedGraph (r : ℝ) (hr : 0 ≤ r) := numberWeightedGraph Sector r hr
abbrev electronNumberWeightedGraph (r : ℝ) (hr : 0 ≤ r) := numberWeightedGraph ElectronSector r hr

