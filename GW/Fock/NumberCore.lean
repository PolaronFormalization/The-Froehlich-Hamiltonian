lemma phononNumber_selfadjoint : IsSelfAdjointOperator (E := Carrier) numberOperator := numberDiagonal_selfadjoint Sector
set_option backward.isDefEq.respectTransparency.types false in
lemma electronNumber_selfadjoint : IsSelfAdjointOperator (E := ElectronBosonSum) electronNumberOperator := numberDiagonal_selfadjoint ElectronSector
set_option backward.isDefEq.respectTransparency.types false in
lemma phononNumberPower_selfadjoint (r : ℝ) : IsSelfAdjointOperator (E := Carrier) (phononNumberPower r) :=
